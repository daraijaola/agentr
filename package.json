{
  "name": "agentr",
  "version": "0.1.0",
  "private": true,
  "description": "AGENTR \u2014 Autonomous AI Agent Infrastructure on TON & Telegram. Multi-tenant platform where every user gets a real agent: hybrid GramJS router, token-accurate credits, per-tenant sandbox, 120+ tools, native TON execution.",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.6.1",
      "axios": ">=1.16.0",
      "undici": ">=7.28.0",
      "ws": ">=8.21.0",
      "basic-ftp": ">=5.3.1",
      "form-data": ">=4.0.6",
      "fast-uri": ">=3.1.2",
      "@grpc/grpc-js": ">=1.14.4"
    },
    "onlyBuiltDependencies": [
      "@ston-fi/api",
      "better-sqlite3",
      "bufferutil",
      "cpu-features",
      "es5-ext",
      "esbuild",
      "protobufjs",
      "ssh2",
      "utf-8-validate"
    ]
  },
  "dependencies": {
    "pino-pretty": "^13.1.3"
  }
}